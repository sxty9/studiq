{
  "name": "@studiq/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "studiq — KI-Lern-Assistent, -Organisator und -Kollaborator (frontend, mock-first).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test:pencil": "vite build && (vite preview --port 5199 --strictPort & sleep 3; node test/pencil.e2e.mjs; s=$?; kill %1 2>/dev/null; exit $s)"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.61.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2",
    "vite": "^5.4.9"
  }
}
